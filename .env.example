# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and keys from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Never expose to the browser. Used by the
# seed script and any privileged server-side admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Platform ────────────────────────────────────────────────────────────────
# Base domain used for per-listing subdomains, e.g. <slug>.lovethatforyou.app
# In local dev this can stay localhost:3000 (path-based /l/<slug> fallback is
# always available regardless of this value).
NEXT_PUBLIC_BASE_DOMAIN=lovethatforyou.app

# ─── AI (Gemini) ─────────────────────────────────────────────────────────────
# Server-only key from Google AI Studio (https://aistudio.google.com/apikey).
# Used by server actions for the guided listing walkthrough (AI narrative,
# scene suggestions). Never expose to the browser.
GEMINI_API_KEY=your-gemini-api-key

# ─── 3D push-in renders (optional, local, Apple Silicon) ─────────────────────
# Only needed to bake the cinematic dolly sequences. See README "3D push-in
# renders". All values below are optional and have sensible defaults.
#
# Path to the Apple SHARP venv (default is /tmp/... which macOS clears on reboot,
# so set a persistent path):
# RENDER_SHARP_VENV=/Users/you/.sharp-venv
#
# Output/quality/motion tuning:
# RENDER_WIDTH=2560
# RENDER_HEIGHT=1440
# RENDER_QUALITY=90
# RENDER_FRAMES=60
# RENDER_ZOOM=0.03
# RENDER_FOV=46.8
# RENDER_START=0
